<mvc:View controllerName="learning.learningproject.controller.App"
   xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	displayBlock="true">
		<App id="app">
			<FlexibleColumnLayout id="fcl">
				<landmarkInfo>
					<FlexibleColumnLayoutAccessibleLandmarkInfo
						firstColumnLabel="Custom Label For First Column"
						lastColumnLabel="Test Label for Last Column"/>
				</landmarkInfo>
				<beginColumnPages>
					<mvc:XMLView id="beginView" async="true" viewName="learning.learningproject.view.List"/>
				</beginColumnPages>
				<midColumnPages>
					<mvc:XMLView id="midView" async="true" viewName="learning.learningproject.view.Detail"/>
				</midColumnPages>
			</FlexibleColumnLayout>
		</App>
</mvc:View>



