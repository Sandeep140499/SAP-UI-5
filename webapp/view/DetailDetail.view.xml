<mvc:View
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc"
    displayBlock="true"
    controllerName="learning.learningproject.controller.DetailDetail"
    height="100%"
>
    <Page
        id="detailDetailPage"
        title="Details"
        backgroundDesign="Transparent"
    >
        <footer>
            <Bar
                id="footer"
                class="paddingBottom"
            >
                <contentLeft>
                    <Button
                        id="previousPage"
                        text="Back"
                        press="handleNavigateToMidColumnPress"
                    />
                </contentLeft>
                <contentRight>
                    <Button
                        id="nextPage"
                        text="Next"
                        press="handleNavigateToLastColumn"
                    />
                </contentRight>
            </Bar>
        </footer>
    </Page>
</mvc:View>
