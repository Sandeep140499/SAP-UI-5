<mvc:View xmlns="sap.m" xmlns:mvc="sap.ui.core.mvc" displayBlock="true" controllerName="learning.learningproject.controller.List" height="100%">
	<Page id="listPage" title="Product Categories">
        <Button class="sapUiTinyMargin" text="Navigate to Middle Column" press="handleNavigateToMidColumnPress"/>
		<List id="categoryList" items="{/}" mode="SingleSelectMaster" noDataText="No categories available">
			<StandardListItem title="{CategoryName}" description="{NumberOfProducts} Products" type="Active" />
            
		</List>
		<footer>
			<Bar id="footer" class="paddingBottom">
				<contentLeft>
					<Button id="previousPage" text="Previous Page" press="onNavigateToSecondPage" />
				</contentLeft>
				<contentRight>
					<Button id="nextPage" text="Next Page" press="onNavigateToFourthPage" />
				</contentRight>
			</Bar>
		</footer>
	</Page>
</mvc:View>