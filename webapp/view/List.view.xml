<mvc:View
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc"
    displayBlock="true"
    controllerName="learning.learningproject.controller.List"
    height="100%"
>
    <Page
        id="listPage"
        title="Product Categories"
    >
        <List
            id="categoryList"
            items="{/}"
            mode="SingleSelectMaster"
            noDataText="No categories available"
            itemPress="handleNavigateToSidePanel"
        >
            <StandardListItem
                title="{CategoryName}"
                description="{NumberOfProducts} Products"
                type="Active"
            />
        </List>

